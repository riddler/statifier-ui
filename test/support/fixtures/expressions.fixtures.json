{
  "version": 1,
  "datasets": {
    "minor": {
      "user": {
        "age": 15,
        "country": "US"
      }
    },
    "adult-us": {
      "user": {
        "age": 30,
        "country": "US"
      }
    }
  },
  "expressions": {
    "is-adult-us": {
      "source": "user.age >= 18 and user.country == 'US'",
      "expect": {
        "minor": false,
        "adult-us": true
      }
    },
    "signup-date": {
      "source": "user.signup_date",
      "expect": {
        "minor": { "$undefined": true },
        "adult-us": { "$date": "2026-01-15" }
      }
    }
  }
}
